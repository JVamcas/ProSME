{
  "name": "prosme-mockups",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:option-a",
    "dev:option-a": "npm run dev --workspace @prosme/option-a",
    "dev:option-b": "npm run dev --workspace @prosme/option-b",
    "dev:option-c": "npm run dev --workspace @prosme/option-c",
    "build": "npm run build --workspaces --if-present",
    "build:option-a": "npm run build --workspace @prosme/option-a",
    "build:option-b": "npm run build --workspace @prosme/option-b",
    "build:option-c": "npm run build --workspace @prosme/option-c",
    "lint": "npm run lint --workspaces --if-present"
  }
}
