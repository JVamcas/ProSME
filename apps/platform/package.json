{
  "name": "@prosme/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "SKIP_CMS_PRERENDER=1 next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:public": "playwright test",
    "test:watch": "vitest",
    "check:architecture": "node ../../scripts/development/check-architecture.mjs && node ../../scripts/development/check-form-architecture.mjs",
    "check:files": "node ../../scripts/development/check-file-limits.mjs",
    "payload": "payload",
    "payload:types": "payload generate:types",
    "payload:importmap": "payload generate:importmap",
    "bootstrap:admin": "NODE_OPTIONS=--conditions=react-server node --env-file-if-exists=../../.env ../../node_modules/payload/bin.js run ../../scripts/seed/bootstrap-admin.ts",
    "db:seed": "npm run db:seed:content && npm run db:seed:forms && npm run db:seed:workflow",
    "db:seed:content": "NODE_ENV=production NODE_OPTIONS=--conditions=react-server payload seed-database",
    "db:seed:forms": "NODE_OPTIONS=--conditions=react-server node --env-file-if-exists=../../.env ../../node_modules/payload/bin.js run ../../scripts/seed/seed-standard-forms.ts",
    "db:seed:workflow": "NODE_OPTIONS=--conditions=react-server node --env-file-if-exists=../../.env ../../node_modules/payload/bin.js run ../../scripts/seed/seed-standard-workflow.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@google-cloud/storage": "8.1.0",
    "@hookform/resolvers": "5.9.1",
    "@internationalized/date": "3.12.3",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-gcs": "3.89.0",
    "@radix-ui/react-slot": "1.3.3",
    "@rjsf/core": "6.10.1",
    "@rjsf/utils": "6.10.1",
    "@rjsf/validator-ajv8": "6.10.1",
    "@tanstack/react-query": "5.90.16",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "firebase": "12.19.0",
    "firebase-admin": "14.4.0",
    "graphql": "16.11.0",
    "lucide-react": "1.42.0",
    "next": "16.3.4",
    "payload": "3.89.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-aria-components": "1.20.0",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-querybuilder": "8.24.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
