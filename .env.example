# Application
ENVIRONMENT=local
PUBLIC_SITE_URL=http://localhost:3008
APP_PUBLIC_URL=http://localhost:3008
APPLICATION_BIND_ADDRESS=0.0.0.0
APPLICATION_PORT=3008
SESSION_COOKIE_DAYS=5

# PostgreSQL
DATABASE_URL=postgresql://smefund:smefund-local-only@db:5432/smefund

# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Real Firebase web application configuration (Firebase Console > Project settings)
# These values are served to the browser at runtime and are not built into the image.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Firebase Admin. Locally, use either service-account JSON or the two split fields.
# On GCP, omit credentials and use Application Default Credentials on the workload identity.
# Optional local override; defaults to PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Cloud Storage bucket shared by namespaced platform objects. ENVIRONMENT
# selects the local, dev, or prod object root. Branding assets are stored under
# <environment>/utilities/brand/. Use the bare bucket name, not gs://.
# Grant the configured service account, workload identity, or local ADC identity
# object access to the bucket. GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON is optional;
# when omitted, the Firebase Admin service account or ADC is used.
GCS_DOCUMENTS_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=

# Gmail SMTP notification delivery. Supply secrets from the deployment secret store.
# Quote values that contain spaces (for example, SMTP_APP_PASSWORD="word word word word").
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Authenticated, bounded notification processor invocation.
NOTIFICATION_PROCESSOR_SECRET=
FUNDING_CALL_LIFECYCLE_PROCESSOR_SECRET=
NOTIFICATION_PROCESSOR_BATCH_SIZE=
NOTIFICATION_PROCESSOR_EXECUTION_TIMEOUT_MS=
NOTIFICATION_PROCESSOR_LOCK_TIMEOUT_MS=
NOTIFICATION_PROCESSOR_INTERVAL_MS=60000
# One scheduler invokes both processors independently. Blank workflow secret
# reuses NOTIFICATION_PROCESSOR_SECRET; an explicit value isolates credentials.
WORKFLOW_PROCESSOR_SECRET=
WORKFLOW_PROCESSOR_BATCH_SIZE=25
WORKFLOW_PROCESSOR_EXECUTION_TIMEOUT_MS=45000
WORKFLOW_PROCESSOR_INTERVAL_MS=60000
# Analytics synchronization uses the existing scheduler and PostgreSQL database.
# Leave the secret blank to reuse NOTIFICATION_PROCESSOR_SECRET.
REPORTING_PROCESSOR_SECRET=
REPORTING_PROCESSOR_INTERVAL_MS=15000
REPORTING_SCHEDULER_REQUEST_TIMEOUT_MS=60000
WORKFLOW_SCHEDULER_REQUEST_TIMEOUT_MS=60000
NOTIFICATION_SCHEDULER_REQUEST_TIMEOUT_MS=60000
NOTIFICATION_SCHEDULER_MAX_CONSECUTIVE_FAILURES=5

# D1 website analytics. Numeric GA property ID differs from the G- measurement ID.
# Browser collection uses this environment ID only; blank disables GA collection.
GA_MEASUREMENT_ID=
# Use the GA property's actual IANA timezone and first collection date.
# GA credentials remain server-only; blank JSON uses Application Default Credentials.
GA_PROPERTY_ID=
GA_PROPERTY_TIMEZONE=
GA_COLLECTION_START_DATE=
GA_SERVICE_ACCOUNT_JSON=
# Enable after disabling GA enhanced measurement in the web data stream.
# Automatic URL/form/download collection bypasses the approved metadata contract.
GA_COLLECTION_ENABLED=false
# Enable platform-owned public click and scroll-depth capture after its migration.
WEBSITE_HEATMAP_ENABLED=false


# AI provider reuses the existing GCP project and credentials. Switches are managed in Chatbot > Settings.
CHATBOT_MODEL=gemini-3.8-flash
CHATBOT_MODEL_LOCATION=global
# Optional bounded retention defaults; recipient selection uses notification rules.
CHATBOT_POLICY_JSON=
# Schedule POST /api/internal/chatbot/process with this bearer secret (32+ characters).
CHATBOT_PROCESSOR_SECRET=
# Enable only behind a proxy that overwrites x-real-ip; keyed hashes expire after one day.
CHATBOT_TRUST_PROXY_IP=true
CHATBOT_NETWORK_HASH_SECRET=
