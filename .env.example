# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SESSION_COOKIE_DAYS=5

# PostgreSQL (local default from infrastructure/local/compose.yaml)
DATABASE_URL=postgresql://smefund:smefund-local-only@127.0.0.1:5432/smefund

# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Real Firebase web application configuration (Firebase Console > Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin. Locally, use either service-account JSON or the two split fields.
# On GCP, omit credentials and use Application Default Credentials on the workload identity.
# Optional local override; defaults to NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
